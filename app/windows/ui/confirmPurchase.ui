   <string notr="true">#mainWindow {
	font-family: Arial;
}

QLabel {
    font-size: 18px;
    color: #222;
}

#labelAdd{
	font-size:24px;
}

#menu {
    background: #EAEB8C;
    border-bottom: 1.5px solid #bdbdbd;
}

#menu QLabel {
    font-size: 16px;
    color: #222;
}

#menu QWidget:hover {
    background: #e0e0e0;
}

#menu QWidget[active=&quot;true&quot;] {
    background: #ffffff;
    border-bottom: 3px solid #487c7e;
}

#menu QWidget[active=&quot;true&quot;] QLabel {
    font-weight: bold;
}

#menu QWidget {
    border-right: 1px solid #bdbdbd;
    border-left: 1px solid #bdbdbd;

}

QLineEdit {
    background: white;
    border-radius: 4px;
    padding: 6px;
    border: 1px solid #c4c4c4;
    font-size: 20px;
}

QLineEdit:focus {
    border: 1px solid #487c7e;
}

QLabel#labelTitulo{
    font-size: 36px;
    font-weight: 600;
    color: #222;
}

QPushButton#btnAdd {
    background: transparent;
    font-size: 36px;
    color: #222;
    border: none;
}
QPushButton#btnAdd:hover {
    color: #444;
}

QToolButton {
    background: transparent;
    border: none;
}
QToolButton:hover {
    background: #dcdcdc;
    border-radius: 4px;
}

QPushButton#btnBack {
    background: transparent;
    border: none;
    font-size: 36px;
    color: #222;
}
QPushButton#btnBack:hover {
    color: #555;
}


QTableWidget {
    background: #EAEB8C;
    gridline-color: #bcbcbc;
    border-radius: 8px;
    font-size: 14px;
    color: #222;
}

QHeaderView::section {
    background: #EBEC8D;
    padding: 6px 4px;
    font-weight: bold;
    border: 1px solid #b4b4b4;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background: #c6d3d6;
    color: #000;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #dcdcdc;
    border-radius: 4px;
}

QScrollBar::handle {
    background: #aaaaaa;
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: #888888;
}

#tablaContenedor {
    background: #7835ff;
    border-radius: 10px;
    padding: 8px;
}

QPushButton#btnAddProducto,
QPushButton#btnRemoveProducto {
    background: transparent;
    border: none;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#btnAddProducto:hover,
QPushButton#btnRemoveProducto:hover {
    color: #487c7e;
}

QPushButton#btnCancelar {
    background: #e7b0b0;
    border: none;
    border-radius: 6px;
    padding: 8px 26px;
    font-size: 16px;
}

QPushButton#btnCancelar:hover {
    background: #d59a9a;
}

QPushButton#btnGuardar {
    background: #b9e3a6;
    border: none;
    border-radius: 6px;
    padding: 8px 26px;
    font-size: 16px;
}

QPushButton#btnGuardar:hover {
    background: #a3d68c;
}

#panelRegistro {
    background: #e0e0e0;
    border-radius: 8px;
	border: 1.5px solid #b8b8b8;
    padding: 16px;
}
</string>
