QLineEdit {
    background: white;
    border-radius: 4px;
    padding: 6px;
    border: 1px solid #c4c4c4;
    font-size: 20px;
}

QLineEdit:focus {
    border: 1px solid #487c7e;
}

QLabel {
    color: #333;
    font-size: 20px;
}

#labelLink{
    color: #4054d6;
    font-size: 13px;
}
#labelLink:hover {
    text-decoration: underline;
}

QPushButton {
    background: #dedede;
    color: #333;
    border-radius: 6px;
    padding: 7px;
    border: none;
    font-size: 18px;
}

QPushButton:hover {
    background: #cacaca;
}

QPushButton:pressed {
    background: #b5b5b5;
}</string>
