  <property name="styleSheet">
   <string notr="true">QMainWindow {
	font-family: Arial;
    background-color: #F0F6F9;
}

QLabel {
    font-size: 18px;
    color: #222;
}

#menu{
    background-color: #907c83;
    color: #000000;
    border: 1px solid #7f5b5f;
    border-bottom: 1.5px solid #7f5b5f;
}

#menu QLabel {
    font-size: 16px;
    color: #222;
}

#menu QWidget:hover {
    background: #7f5b5f;
}

#menu QWidget[active=&quot;true&quot;] {
    background: #7f5b5f;
    border-bottom: 3px solid #7f5b5f;
}

#menu QWidget[active=&quot;true&quot;] QLabel {
    font-weight: bold;
}

#menu QWidget {
    border-right: 1px solid #7f5b5f;
    border-left: 1px solid #7f5b5f;
}

QTableWidget {
    background-color: #ededed;
    alternate-background-color: #FFFFF0; 
    gridline-color: #7f5b5f;          
    border: 1px solid #7f5b5f;
    border-radius: 4px;
    selection-background-color: #FFFFCC; 
    selection-color: #000000;
}

QHeaderView::section {
    background-color: #ededed;       
    color: #000000;
    font-weight: bold;
    padding: 4px;
    border: 1px solid #7f5b5f;        
}

QPushButton {
    background-color: #FFFF99;         
    color: #000000;
    border: 1px solid #7f5b5f;         
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: normal;
}

QPushButton:hover {
    background-color: #FFFF77;         
    border-color: #DDDD66;           
}

QPushButton:pressed {
    background-color: #DDDD66;          
}

QLineEdit {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #7a7a7a;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #FFFFCC;
}

QLineEdit:focus {
    border: 2px solid #666666;    
}

QLabel#labelTitulo {
    color: #000000;
    font-weight: bold;
    font-size: 24px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #FFFFF1;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #d9d9d9;       
}

QScrollBar::handle:hover {
    background-color: #bdbdbd;        
}

QHeaderView::section:hover {
    background-color: #FFFF77;         
}

QTableWidget::item:hover {
    background-color: #FFFFCC;        
}




QPushButton#btnAdd {
    background: transparent;
    font-size: 36px;
    color: #222;
    border: none;
}
QPushButton#btnAdd:hover {
    color: #444;
}

QToolButton {
    background: transparent;
    border: none;
}
QToolButton:hover {
    background: #dcdcdc;
    border-radius: 4px;
}

QPushButton#btnBack {
    background: transparent;
    border: none;
    font-size: 36px;
    color: #222;
}
QPushButton#btnBack:hover {
    color: #555;
}



QScrollBar:vertical,
QScrollBar:horizontal {
    background: #dcdcdc;
    border-radius: 4px;
}

QScrollBar::handle {
    background: #aaaaaa;
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: #888888;
}


QPushButton#btnAddProducto,
QPushButton#btnRemoveProducto {
    background: transparent;
    border: none;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#btnAddProducto:hover,
QPushButton#btnRemoveProducto:hover {
    color: #487c7e;
}

QPushButton#btnCancelar {
    background: #e7b0b0;
    border: none;
    border-radius: 6px;
    padding: 8px 26px;
    font-size: 16px;
}

QPushButton#btnCancelar:hover {
    background: #d59a9a;
}

QPushButton#btnGuardar {
    background: #b9e3a6;
    border: none;
    border-radius: 6px;
    padding: 8px 26px;
    font-size: 16px;
}

QPushButton#btnGuardar:hover {
    background: #a3d68c;
}

